{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "paiva-portfolio",
  "compatibility_date": "2026-08-18",
  "assets": {
    "directory": "./dist"
  },
  "routes": [
    { "pattern": "paiva.lat", "custom_domain": true },
    { "pattern": "www.paiva.lat", "custom_domain": true }
  ],
  "observability": { "enabled": true }
}
